# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local dev derivative output (in prod this is a Docker volume at /processed)
/.processed

# generated Prisma client (regenerated on install/build)
/generated

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local dev ingest folder (host side of the /ingest bind mount)
/.ingest

# local-only compose overrides
docker-compose.override.yml

# playwright mcp artifacts
.playwright-mcp/

# editor swap files
*.swp
*.swo
