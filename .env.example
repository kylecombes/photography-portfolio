# Copy to .env and fill in. Never commit the real .env.

# --- Ingestion ---
# Host folder to watch for incoming full-scale JPEGs (bind-mounted read-only into the web container).
INGEST_DIR=/absolute/path/to/your/photos/incoming

# Derivative encoding
THUMB_WIDTH=600
FULL_QUALITY=70

# --- Database ---
POSTGRES_USER=portfolio
POSTGRES_PASSWORD=change-me
POSTGRES_DB=portfolio
# Points at the `db` service on the compose network.
DATABASE_URL=postgresql://portfolio:change-me@db:5432/portfolio?schema=public

# --- Web / proxy ---
# Domain for Caddy. Use ":80" for plain HTTP on localhost, or "photos.example.com" for auto-HTTPS.
SITE_DOMAIN=:80

# --- Analytics (optional) ---
# Path (inside the container) to a GeoLite2-City.mmdb for coarse IP->city
# resolution on sessions. Download from MaxMind (free account), mount it via the
# commented volume in docker-compose.yml, then set this to its path, e.g.:
#   GEOLITE_DB=/data/GeoLite2-City.mmdb
# Leave blank to disable geolocation (the rest of the app is unaffected).
GEOLITE_DB=
